#!/usr/bin/env bash
# Mac-side control for the Fruit Drama stack.
#
# Replaces start-fruit-drama.command, whose three assumptions are all dead: the
# ssh alias `james` (now spark-2e6c), the tmux session `vs`, and opening
# interface/index.html from disk (the app is now served by the gateway).
#
# Host resolution never hardcodes an address. v1 baked a Tailscale IP into the
# generated HTML and it went stale; the fix is a resolver, not a convention.
set -uo pipefail

SPARK="${SPARK_HOST:-spark-2e6c}"
SSH=(ssh -o BatchMode=yes -o ConnectTimeout=8 -o ServerAliveInterval=15 "$SPARK")
GATEWAY_PORT="${GATEWAY_PORT:-8080}"
REMOTE_ROOT="\$HOME/fruit"

usage() {
  cat <<USAGE
usage: fruit <command>

  status     one-screen health of the box, models and jobs
  corpus     progress of the corpus generation run
  logs <name> follow a log: corpus (default), train, judge, gateway, model
  up         start model + gateway, wait for ready, open the app
  down       stop gateway and model (frees the GPU)
  sync       push local code to the Spark
  judge      judge the gate-accepted corpus with a different model family
  dataset    assemble train/val JSONL + dataset card from the judged corpus
  train      launch the LoRA run (runs --smoke first and refuses on failure)
  eval       run the ship-gate eval against the serving endpoint
  ab         blind position-swapped A/B of two endpoints
  serve      swap the served GGUF (args: <gguf-path> <alias> [slots] [ctx])
  shell      ssh into the Spark at the project root
USAGE
}

case "${1:-}" in
status)
  "${SSH[@]}" bash -s <<'REMOTE'
    echo "=== gpu ==="
    nvidia-smi --query-gpu=name,utilization.gpu,temperature.gpu --format=csv,noheader
    echo "=== memory ==="; free -g | sed -n 2p
    echo "=== disk ==="; df -h / | tail -1
    echo "=== models on disk ==="
    find "$HOME/fruit/models/gguf" -name "*.gguf" -printf "%10.1f GB  %f\n" 2>/dev/null |
      awk '{printf "%8.1f GB  %s\n", $1/1073741824*1073741824/1073741824, $3}' 2>/dev/null ||
      find "$HOME/fruit/models/gguf" -name "*.gguf" -exec du -h {} + 2>/dev/null
    echo "=== served model ==="
    curl -s localhost:8000/v1/models 2>/dev/null |
      python3 -c 'import json,sys; print([m["id"] for m in json.load(sys.stdin)["data"]])' 2>/dev/null ||
      echo "no model server on :8000"
    echo "=== tmux ==="; tmux ls 2>/dev/null || echo "no sessions"
    echo "=== gateway prompt version ==="
    curl -s localhost:8080/version 2>/dev/null |
      python3 -c 'import json,sys; d=json.load(sys.stdin); print(d["prompt_version"], "| model", d["model"])' 2>/dev/null ||
      echo "gateway not responding"
REMOTE
  # A gateway that started before a prompt change serves the old prompt, so the
  # app and the eval harness would disagree about what is being measured.
  local_v=$(cd "$(dirname "$0")/.." && PYTHONPATH=src python3 -c \
    'from fruitdrama import prompts; print(prompts.prompt_version())' 2>/dev/null)
  remote_v=$("${SSH[@]}" "curl -s localhost:8080/version 2>/dev/null" |
    python3 -c 'import json,sys; print(json.load(sys.stdin)["prompt_version"])' 2>/dev/null)
  if [ -n "$local_v" ] && [ -n "$remote_v" ] && [ "$local_v" != "$remote_v" ]; then
    echo
    echo "WARNING: prompt drift. local=$local_v  gateway=$remote_v"
    echo "         run: ./ops/fruit sync && ./ops/fruit down && ./ops/fruit up"
  fi
  ;;
corpus)
  "${SSH[@]}" bash -s <<'REMOTE'
    R="$HOME/fruit/run1"
    acc=$(wc -l < "$R/accepted.jsonl" 2>/dev/null || echo 0)
    raw=$(wc -l < "$R/raw.jsonl" 2>/dev/null || echo 0)
    rej=$(wc -l < "$R/rejected.jsonl" 2>/dev/null || echo 0)
    echo "generated $raw   accepted $acc   rejected $rej"
    [ "$raw" -gt 0 ] && echo "accept rate $(( 100 * acc / raw ))%"
    echo
    grep -E "^\[" "$HOME/fruit/logs/corpus.log" 2>/dev/null | tail -3
    grep -E "^        (gates|judge)" "$HOME/fruit/logs/corpus.log" 2>/dev/null | tail -2
REMOTE
  ;;
logs)  "${SSH[@]}" "tail -f -n ${3:-40} \$HOME/fruit/logs/${2:-corpus}.log" ;;
sync)
  rsync -az --delete --exclude '__pycache__' --exclude '*.pyc' \
    src/fruitdrama "$SPARK:~/fruit/app/src/"
  rsync -az scripts config serve eval training "$SPARK:~/fruit/app/"
  rsync -az data/gold data/fruit_bible.json data/eval_holdout.json "$SPARK:~/fruit/app/data/"
  echo "synced"
  ;;
up)
  "${SSH[@]}" "tmux has-session -t gateway 2>/dev/null || tmux new-session -d -s gateway \
    'cd ~/fruit/app && FRUIT_UPSTREAM=http://127.0.0.1:8000 \
     ~/fruit/venv/bin/uvicorn serve.gateway.app:app --host 0.0.0.0 --port $GATEWAY_PORT \
     2>&1 | tee ~/fruit/logs/gateway.log'"
  printf "waiting for gateway"
  for _ in $(seq 1 60); do
    if "${SSH[@]}" "curl -sf localhost:$GATEWAY_PORT/healthz >/dev/null"; then echo " ready"; break; fi
    printf "."; sleep 2
  done
  open "http://$SPARK:$GATEWAY_PORT/"
  ;;
down) "${SSH[@]}" "tmux kill-session -t gateway 2>/dev/null; tmux kill-session -t model 2>/dev/null; echo stopped" ;;
judge)
  "${SSH[@]}" "cd ~/fruit/app && tmux kill-session -t judge 2>/dev/null; \
    tmux new-session -d -s judge '~/fruit/venv/bin/python -u scripts/judge_corpus.py \
      --accepted ~/fruit/run1/accepted.jsonl --out ~/fruit/run1/judged.jsonl \
      --judge-url http://127.0.0.1:8000 --judge-model \${JUDGE_MODEL:-judge} \
      --concurrency 16 2>&1 | tee ~/fruit/logs/judge.log'"
  echo "judge pass started; follow with: ./ops/fruit logs judge"
  ;;
dataset)
  "${SSH[@]}" "cd ~/fruit/app && ~/fruit/venv/bin/python scripts/build_dataset.py \
    --accepted ~/fruit/run1/accepted.jsonl --judged ~/fruit/run1/judged.jsonl \
    --out-prefix ~/fruit/run1/story_sft"
  ;;
train)
  # Smoke first, always: it loads the model, runs one fwd/bwd and prints peak
  # memory in about seven minutes. Starting a 15-hour run on an untested memory
  # budget is how you lose a day.
  echo "smoke test first..."
  "${SSH[@]}" "cd ~/fruit/app && HF_HOME=\$HOME/fruit/hf HF_HUB_OFFLINE=1 \
    ~/fruit/venv/bin/python -u training/train_lora_moe.py \
      --train ~/fruit/run1/story_sft.train.jsonl --val ~/fruit/run1/story_sft.val.jsonl \
      --smoke 2>&1 | tail -4"
  read -r -p "smoke looked ok? start the full run [y/N] " ans
  [ "$ans" = "y" ] || { echo aborted; exit 1; }
  "${SSH[@]}" "cd ~/fruit/app && tmux kill-session -t train 2>/dev/null; \
    tmux new-session -d -s train 'HF_HOME=\$HOME/fruit/hf HF_HUB_OFFLINE=1 \
      ~/fruit/venv/bin/python -u training/train_lora_moe.py \
      --train ~/fruit/run1/story_sft.train.jsonl --val ~/fruit/run1/story_sft.val.jsonl \
      --out ~/fruit/out/qwen3-30b-a3b-fruit-lora 2>&1 | tee ~/fruit/logs/train.log'"
  echo "training started; follow with: ./ops/fruit logs train"
  ;;
eval)
  "${SSH[@]}" "cd ~/fruit/app && ~/fruit/venv/bin/python eval/run_eval.py \
    --endpoint http://127.0.0.1:8000 --model \${FRUIT_MODEL:-fruit} --tag \${TAG:-manual} --n 120 \
    --judge-url \${JUDGE_URL:-} --judge-model \${JUDGE_MODEL:-judge}"
  ;;
ab)
  "${SSH[@]}" "cd ~/fruit/app && ~/fruit/venv/bin/python eval/ab_compare.py \
    --a-url http://127.0.0.1:8000 --a-model \${A_MODEL:-fruit} --a-label candidate \
    --b-url http://127.0.0.1:8001 --b-model \${B_MODEL:-base} --b-label base \
    --judge-url \${JUDGE_URL:-http://127.0.0.1:8002} --judge-model \${JUDGE_MODEL:-judge} --n 120"
  ;;
serve)
  GGUF="${2:?usage: fruit serve <gguf-path> <alias> [slots] [ctx]}"
  ALIAS="${3:?alias required}"
  "${SSH[@]}" "tmux kill-session -t model 2>/dev/null; sleep 3; \
    tmux new-session -d -s model 'MODEL=$GGUF ALIAS=$ALIAS PORT=8000 \
      SLOTS=${4:-8} CTX=${5:-65536} bash ~/fruit/app/serve/serve_llama.sh \
      2>&1 | tee ~/fruit/logs/$ALIAS.log'"
  printf "waiting for %s" "$ALIAS"
  for _ in $(seq 1 120); do
    "${SSH[@]}" "curl -sf localhost:8000/health >/dev/null" && { echo " ready"; break; }
    printf "."; sleep 4
  done
  ;;
shell) exec ssh "$SPARK" -t "cd ~/fruit/app && exec bash -l" ;;
*) usage; exit 1 ;;
esac
