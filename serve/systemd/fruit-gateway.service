[Unit]
Description=Fruit Drama gateway (FastAPI)
After=network-online.target fruit-model.service
# Wants, deliberately NOT Requires: the gateway must stay up while the model
# loads so it can serve /readyz with a warming state. Requires= would turn the
# nicest UX state into a connection refused.
Wants=fruit-model.service

[Service]
Type=exec
WorkingDirectory=%h/fruit/app
EnvironmentFile=%h/fruit/env/gateway.env
ExecStart=%h/fruit/venv/bin/uvicorn serve.gateway.app:app --host 0.0.0.0 --port 8080
Restart=always
RestartSec=2
MemoryMax=2G
OOMScoreAdjust=200

[Install]
WantedBy=default.target
